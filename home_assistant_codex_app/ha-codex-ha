#!/usr/bin/env bash
# Controlled Home Assistant Core actions for HA Codex.
# The Supervisor supplies the token and routes requests internally.
# The token is never printed.
set -euo pipefail

readonly API_BASE="http://supervisor/core/api"
readonly HISTORY_MAX_BYTES=1048576
readonly HISTORY_MAX_RECORDS=500
readonly HISTORY_MAX_SECONDS=604800

usage() {
  cat <<'EOF'
Usage: ha-codex-ha <command>

Commands:
  status
                                 Check that the Home Assistant Core API is reachable.
  check
                                 Validate configuration.yaml and included configuration.
  reload <automation|script|scene|group|template|core|dashboard-resources>
                                 Reload one supported Home Assistant configuration area.
  restart
                                 Validate configuration, then restart Home Assistant Core.
  history <entity_id> [start_utc end_utc]
                                 Read history for an existing entity.

History:
  Without dates, reads the last 24 hours.
  Custom dates must use UTC format: YYYY-MM-DDTHH:MM:SSZ
  Custom range is limited to 7 days.
  Each response is limited to 500 records and 1 MiB.

Control actions must be enabled in the HA Codex add-on Configuration tab.
Core restart additionally requires "Allow Home Assistant Core restart".
History additionally requires "Allow Home Assistant history read".
EOF
}

require_control() {
  if [ "${HA_CODEX_HOME_ASSISTANT_CONTROL:-false}" != "true" ]; then
    printf '%s\n' 'Home Assistant control actions are disabled. Enable "Allow Home Assistant control actions" in HA Codex Configuration, then restart this add-on.' >&2
    exit 77
  fi
}

api() {
  local method="$1"
  local path="$2"
  local payload="${3:-}"

  if [ -z "${SUPERVISOR_TOKEN:-}" ]; then
    printf '%s\n' 'Home Assistant API access is unavailable. Restart HA Codex after installing this version.' >&2
    exit 78
  fi

  local args=(
    --fail-with-body
    --silent
    --show-error
    --max-time 30
    --request "${method}"
    --header "Authorization: Bearer ${SUPERVISOR_TOKEN}"
    --header "Content-Type: application/json"
  )

  if [ -n "${payload}" ]; then
    args+=(--data "${payload}")
  fi

  curl "${args[@]}" "${API_BASE}${path}"
}

check_config() {
  local response
  response="$(api POST /config/core/check_config '{}')"

  if [ "$(printf '%s' "${response}" | jq -r '.result // empty')" != "valid" ]; then
    printf '%s\n' 'Home Assistant configuration validation failed:' >&2
    printf '%s\n' "${response}" | jq -r '.errors // .' >&2
    return 1
  fi

  printf '%s\n' 'Home Assistant configuration is valid.'
}

call_service() {
  local domain="$1"
  local service="$2"

  api POST "/services/${domain}/${service}" '{}'
  printf '%s\n' "Requested Home Assistant action: ${domain}.${service}."
}

read_history() {
  local entity="${1:-}"
  local requested_start="${2:-}"
  local requested_end="${3:-}"

  if [ "${HA_CODEX_ALLOW_HOME_ASSISTANT_HISTORY:-false}" != "true" ]; then
    printf '%s\n' 'History access is disabled in HA Codex configuration.' >&2
    exit 77
  fi

  # Accept only a syntactically valid domain.object entity_id.
  if [[ ! "${entity}" =~ ^[a-zA-Z0-9_]+\.[a-zA-Z0-9_]+$ ]]; then
    printf '%s\n' 'Invalid entity_id. Expected a domain.object identifier.' >&2
    exit 64
  fi

  if [ -z "${SUPERVISOR_TOKEN:-}" ]; then
    printf '%s\n' 'Home Assistant API access is unavailable.' >&2
    exit 78
  fi

  # Both custom dates must be provided together.
  if { [ -n "${requested_start}" ] && [ -z "${requested_end}" ]; } ||
     { [ -z "${requested_start}" ] && [ -n "${requested_end}" ]; }; then
    printf '%s\n' 'Provide both start_utc and end_utc, or neither.' >&2
    exit 64
  fi

  local now_epoch start_epoch end_epoch start end url
  local tmp bytes response curl_status
  local -a pipe_status

  now_epoch="$(date -u '+%s')" || {
    printf '%s\n' 'Could not calculate current time.' >&2
    exit 1
  }

  if [ -z "${requested_start}" ]; then
    # Default behavior remains the last 24 hours.
    start_epoch="$((now_epoch - 86400))"
    end_epoch="${now_epoch}"
  else
    # Require explicit UTC timestamps.
    if [[ ! "${requested_start}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] ||
       [[ ! "${requested_end}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]]; then
      printf '%s\n' 'Invalid date format. Use YYYY-MM-DDTHH:MM:SSZ in UTC.' >&2
      exit 64
    fi

    # BusyBox date requires an explicit input format for ISO timestamps.
    start_epoch="$(
      date -u -D "%Y-%m-%dT%H:%M:%SZ" -d "${requested_start}" '+%s'
    )" || {
      printf '%s\n' 'Invalid history start time.' >&2
      exit 64
    }

    end_epoch="$(
      date -u -D "%Y-%m-%dT%H:%M:%SZ" -d "${requested_end}" '+%s'
    )" || {
      printf '%s\n' 'Invalid history end time.' >&2
      exit 64
    }
  fi

  if [ "${start_epoch}" -ge "${end_epoch}" ]; then
    printf '%s\n' 'History start must be earlier than end.' >&2
    exit 64
  fi

  if [ "$((end_epoch - start_epoch))" -gt "${HISTORY_MAX_SECONDS}" ]; then
    printf '%s\n' 'History range exceeds the 7-day limit.' >&2
    exit 64
  fi

  if [ "${end_epoch}" -gt "${now_epoch}" ]; then
    printf '%s\n' 'History end cannot be in the future.' >&2
    exit 64
  fi

  start="$(
    date -u -d "@${start_epoch}" '+%Y-%m-%dT%H:%M:%SZ'
  )" || {
    printf '%s\n' 'Could not format history start time.' >&2
    exit 1
  }

  end="$(
    date -u -d "@${end_epoch}" '+%Y-%m-%dT%H:%M:%SZ'
  )" || {
    printf '%s\n' 'Could not format history end time.' >&2
    exit 1
  }

  # Verify that Home Assistant currently knows this entity.
  local state_response
  if ! state_response="$(api GET "/states/${entity}" 2>/dev/null)"; then
    printf '%s\n' "Entity not found or unavailable: ${entity}." >&2
    exit 1
  fi

  if ! printf '%s' "${state_response}" |
    jq -e --arg entity "${entity}" '.entity_id == $entity' >/dev/null; then
    printf '%s\n' "Home Assistant did not confirm entity: ${entity}." >&2
    exit 1
  fi

  url="${API_BASE}/history/period/${start}?filter_entity_id=${entity}&end_time=${end}&minimal_response&no_attributes"

  tmp="$(mktemp)" || {
    printf '%s\n' 'Could not create a temporary file.' >&2
    exit 1
  }

  # Read at most 1 MiB + 1 byte to detect oversized output.
  set +e
  curl \
    --fail-with-body \
    --silent \
    --show-error \
    --max-time 60 \
    --header "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    --header "Content-Type: application/json" \
    "${url}" |
    head -c "$((HISTORY_MAX_BYTES + 1))" > "${tmp}"
  pipe_status=("${PIPESTATUS[@]}")
  set -e

  curl_status="${pipe_status[0]}"
  bytes="$(wc -c < "${tmp}")"

  if [ "${bytes}" -gt "${HISTORY_MAX_BYTES}" ]; then
    rm -f "${tmp}"
    printf '%s\n' 'History response exceeds the 1 MiB limit; no data returned. Request a shorter interval.' >&2
    exit 1
  fi

  if [ "${curl_status}" -ne 0 ]; then
    rm -f "${tmp}"
    printf '%s\n' 'History request failed.' >&2
    exit 1
  fi

  response="$(cat "${tmp}")"
  rm -f "${tmp}"

  # Validate the History API response structure.
  if ! printf '%s' "${response}" |
    jq -e '
      type == "array" and
      (length == 0 or (.[0] | type == "array"))
    ' >/dev/null; then
    printf '%s\n' 'Home Assistant returned an unexpected history response.' >&2
    exit 1
  fi

  # Return at most 500 most recent records from the requested interval.
  printf '%s' "${response}" |
    jq \
      --arg entity "${entity}" \
      --arg start "${start}" \
      --arg end "${end}" \
      --argjson limit "${HISTORY_MAX_RECORDS}" '
        (.[0] // []) as $records
        | {
            entity_id: $entity,
            start: $start,
            end: $end,
            total_records: ($records | length),
            returned_records:
              (if ($records | length) > $limit
               then $limit
               else ($records | length)
               end),
            truncated: (($records | length) > $limit),
            history: ($records[-$limit:])
          }
      '
}

case "${1:-}" in
  status)
    require_control
    api GET / >/dev/null
    printf '%s\n' 'Home Assistant Core API is reachable.'
    ;;

  check)
    require_control
    check_config
    ;;

  reload)
    require_control
    case "${2:-}" in
      automation) call_service automation reload ;;
      script) call_service script reload ;;
      scene) call_service scene reload ;;
      group) call_service group reload ;;
      template) call_service template reload ;;
      core)
        check_config
        call_service homeassistant reload_core_config
        ;;
      dashboard-resources)
        call_service lovelace reload_resources
        printf '%s\n' 'Dashboard resources were reloaded. Refresh the dashboard in the browser to load its current configuration.'
        ;;
      *)
        usage >&2
        exit 64
        ;;
    esac
    ;;

  restart)
    require_control
    if [ "${HA_CODEX_ALLOW_HOME_ASSISTANT_RESTART:-false}" != "true" ]; then
      printf '%s\n' 'Core restart is disabled. Enable "Allow Home Assistant Core restart" in HA Codex Configuration, then restart this add-on.' >&2
      exit 77
    fi
    check_config
    call_service homeassistant restart
    printf '%s\n' 'Home Assistant Core is restarting. It may be unavailable briefly.'
    ;;

  history)
    if [ "$#" -ne 2 ] && [ "$#" -ne 4 ]; then
      usage >&2
      exit 64
    fi
    read_history "${2:-}" "${3:-}" "${4:-}"
    ;;

  -h|--help|help|"")
    usage
    ;;

  *)
    usage >&2
    exit 64
    ;;
esac
