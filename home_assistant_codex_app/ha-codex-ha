#!/usr/bin/env bash
# Controlled Home Assistant Core actions for HA Codex.
# The Supervisor supplies the token and routes requests internally.
# The token is never printed.
set -euo pipefail

readonly API_BASE="http://supervisor/core/api"
readonly HISTORY_ENTITIES="sensor.betteress_stan_baterii_soc sensor.betteress_rs485_paceex_soc"
readonly HISTORY_MAX_BYTES=1048576
readonly HISTORY_MAX_RECORDS=500

usage() {
  cat <<'EOF'
Usage: ha-codex-ha <command>

Commands:
  status                         Check that the Home Assistant Core API is reachable.
  check                          Validate configuration.yaml and included configuration.
  reload <automation|script|scene|group|template|core|dashboard-resources>
                                 Reload one supported Home Assistant configuration area.
  restart                        Validate configuration, then restart Home Assistant Core.
  history <entity_id>            Read the last 24 hours for an allowed history entity.

Control actions must be enabled in the HA Codex add-on Configuration tab.
Core restart additionally requires "Allow Home Assistant Core restart".
History additionally requires "Allow Home Assistant history read".
EOF
}

require_control() {
  if [ "${HA_CODEX_HOME_ASSISTANT_CONTROL:-false}" != "true" ]; then
    printf '%s\n' 'Home Assistant control actions are disabled. Enable "Allow Home Assistant control actions" in HA Codex Configuration, then restart the add-on.' >&2
    exit 77
  fi
}

api() {
  local method="$1"
  local path="$2"
  local payload="${3:-}"

  if [ -z "${SUPERVISOR_TOKEN:-}" ]; then
    printf '%s\n' 'Home Assistant API access is unavailable. Restart HA Codex after installing this version.' >&2
    exit 78
  fi

  local args=(
    --fail-with-body
    --silent
    --show-error
    --max-time 30
    --request "${method}"
    --header "Authorization: Bearer ${SUPERVISOR_TOKEN}"
    --header "Content-Type: application/json"
  )

  if [ -n "${payload}" ]; then
    args+=(--data "${payload}")
  fi

  curl "${args[@]}" "${API_BASE}${path}"
}

check_config() {
  local response
  response="$(api POST /config/core/check_config '{}')"

  if [ "$(printf '%s' "${response}" | jq -r '.result // empty')" != "valid" ]; then
    printf '%s\n' 'Home Assistant configuration validation failed:' >&2
    printf '%s\n' "${response}" | jq -r '.errors // .' >&2
    return 1
  fi

  printf '%s\n' 'Home Assistant configuration is valid.'
}

call_service() {
  local domain="$1"
  local service="$2"

  api POST "/services/${domain}/${service}" '{}'
  printf '%s\n' "Requested Home Assistant action: ${domain}.${service}."
}

read_history() {
  local entity="${1:-}"

  if [ "${HA_CODEX_ALLOW_HOME_ASSISTANT_HISTORY:-false}" != "true" ]; then
    printf '%s\n' 'History access is disabled in HA Codex configuration.' >&2
    exit 77
  fi

  case " ${HISTORY_ENTITIES} " in
    *" ${entity} "*) ;;
    *)
      printf '%s\n' "History access is restricted to: ${HISTORY_ENTITIES}." >&2
      exit 77
      ;;
  esac

  if [ -z "${SUPERVISOR_TOKEN:-}" ]; then
    printf '%s\n' 'Home Assistant API access is unavailable.' >&2
    exit 78
  fi

  local now_epoch start_epoch start end url tmp bytes response curl_status
  local -a pipe_status

  # BusyBox date does not reliably understand "24 hours ago".
  # Calculate the time range using Unix timestamps instead.
  now_epoch="$(date -u '+%s')" || {
    printf '%s\n' 'Could not calculate current time.' >&2
    exit 1
  }

  start_epoch="$((now_epoch - 86400))"

  start="$(date -u -d "@${start_epoch}" '+%Y-%m-%dT%H:%M:%SZ')" || {
    printf '%s\n' 'Could not calculate history start time.' >&2
    exit 1
  }

  end="$(date -u -d "@${now_epoch}" '+%Y-%m-%dT%H:%M:%SZ')" || {
    printf '%s\n' 'Could not calculate history end time.' >&2
    exit 1
  }

  url="${API_BASE}/history/period/${start}?filter_entity_id=${entity}&end_time=${end}&minimal_response&no_attributes"

  tmp="$(mktemp)" || {
    printf '%s\n' 'Could not create a temporary file.' >&2
    exit 1
  }

  # Read at most 1 MiB + 1 byte. The extra byte detects oversized output.
  # If the response is larger, no partial history is returned.
  set +e
  curl \
    --fail-with-body \
    --silent \
    --show-error \
    --max-time 30 \
    --header "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
    --header "Content-Type: application/json" \
    "${url}" |
    head -c "$((HISTORY_MAX_BYTES + 1))" > "${tmp}"
  pipe_status=("${PIPESTATUS[@]}")
  set -e

  curl_status="${pipe_status[0]}"
  bytes="$(wc -c < "${tmp}")"

  if [ "${bytes}" -gt "${HISTORY_MAX_BYTES}" ]; then
    rm -f "${tmp}"
    printf '%s\n' 'History response exceeds the 1 MiB limit; no data returned.' >&2
    exit 1
  fi

  if [ "${curl_status}" -ne 0 ]; then
    rm -f "${tmp}"
    printf '%s\n' 'History request failed.' >&2
    exit 1
  fi

  response="$(cat "${tmp}")"
  rm -f "${tmp}"

  # The History API returns an outer array with one array per entity.
  # Validate the structure and ensure all returned records match the allowlist.
  if ! printf '%s' "${response}" |
    jq -e --arg entity "${entity}" '
      type == "array" and
      (length == 0 or
        (.[0] |
          type == "array" and
          all(.[]; .entity_id == $entity)
        )
      )
    ' >/dev/null; then
    printf '%s\n' 'Home Assistant returned an unexpected history response.' >&2
    exit 1
  fi

  printf '%s' "${response}" |
    jq \
      --arg entity "${entity}" \
      --arg start "${start}" \
      --arg end "${end}" \
      --argjson limit "${HISTORY_MAX_RECORDS}" '
        (.[0] // []) as $records
        | {
            entity_id: $entity,
            start: $start,
            end: $end,
            total_records: ($records | length),
            returned_records:
              (if ($records | length) > $limit
               then $limit
               else ($records | length)
               end),
            truncated: (($records | length) > $limit),
            history: ($records[-$limit:])
          }
      '
}

case "${1:-}" in
  status)
    require_control
    api GET / >/dev/null
    printf '%s\n' 'Home Assistant Core API is reachable.'
    ;;

  check)
    require_control
    check_config
    ;;

  reload)
    require_control
    case "${2:-}" in
      automation) call_service automation reload ;;
      script) call_service script reload ;;
      scene) call_service scene reload ;;
      group) call_service group reload ;;
      template) call_service template reload ;;
      core)
        check_config
        call_service homeassistant reload_core_config
        ;;
      dashboard-resources)
        call_service lovelace reload_resources
        printf '%s\n' 'Dashboard resources were reloaded. Refresh the dashboard in the browser to load its current configuration.'
        ;;
      *)
        usage >&2
        exit 64
        ;;
    esac
    ;;

  restart)
    require_control
    if [ "${HA_CODEX_ALLOW_HOME_ASSISTANT_RESTART:-false}" != "true" ]; then
      printf '%s\n' 'Core restart is disabled. Enable "Allow Home Assistant Core restart" in HA Codex Configuration, then restart the add-on.' >&2
      exit 77
    fi
    check_config
    call_service homeassistant restart
    printf '%s\n' 'Home Assistant Core is restarting. It may be unavailable briefly.'
    ;;

  history)
    if [ "$#" -ne 2 ]; then
      usage >&2
      exit 64
    fi
    read_history "$2"
    ;;

  -h|--help|help|"")
    usage
    ;;

  *)
    usage >&2
    exit 64
    ;;
esac
